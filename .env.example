# Proveedor de LLM: "ollama" (local, por defecto) o "openai"
LLM_PROVIDER=ollama

# Configuración de Ollama (modelo local, sin costo)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Configuración de OpenAI (opcional, requiere API key)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
